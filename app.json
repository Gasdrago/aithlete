{
  "expo": {
    "name": "AithleteAI",
    "slug": "AithleteAI",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/natively-dark.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/natively-dark.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aithlete.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "AITHLETE needs access to your camera for posture analysis and body projection features.",
        "NSPhotoLibraryUsageDescription": "AITHLETE needs access to your photo library to upload body photos for AI projection.",
        "NSPhotoLibraryAddUsageDescription": "AITHLETE needs permission to save your workout progress photos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/natively-dark.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.aithlete.app",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/images/final_quest_240x240.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-router",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "AITHLETE needs access to your camera for posture analysis and body projection features."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "AITHLETE needs access to your photo library to upload body photos for AI projection."
        }
      ]
    ],
    "scheme": "aithlete",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {}
    }
  },
  "scheme": "AithleteAI"
}